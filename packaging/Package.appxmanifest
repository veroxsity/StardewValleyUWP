<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity Name="BanditVault.StardewValleyUWP" Publisher="CN=BanditVault" Version="0.1.21.0" ProcessorArchitecture="x64"/>
  <mp:PhoneIdentity PhoneProductId="d96f1395-d576-45ad-90f1-69ca45fa63b9" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>StardewValleyUWP</DisplayName>
    <PublisherDisplayName>BanditVault</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0"/>
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.0.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"/>
  </Dependencies>

  <Resources>
    <Resource Language="en-US"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="StardewValleyUWP.App">
      <uap:VisualElements
        DisplayName="StardewValleyUWP"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Stardew Valley on Xbox"
        BackgroundColor="#111318">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#111318"/>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- coreclr needs to jit. codeGeneration has to be a plain capability, a rescap one packs but is never granted -->
    <Capability Name="codeGeneration"/>
    <!-- curseforge api and cdn, steam, and SMAPI's own network calls -->
    <Capability Name="internetClient"/>
    <!-- the key entry page is served to a phone on the same network -->
    <Capability Name="privateNetworkClientServer"/>
  </Capabilities>
</Package>


