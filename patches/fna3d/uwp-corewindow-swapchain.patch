diff --git a/CMakeLists.txt b/CMakeLists.txt
index d818a0d..3a8b57e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -70,6 +70,19 @@ else()
 	)
 endif()
 
+if(WINDOWS_STORE)
+	# the app container has no vulkan loader and no wgl, so d3d11 is the only reachable driver.
+	# dropping spirv also drops mojoshader_vulkan.c, which trips C4703 as an error under /sdl
+	remove_definitions(
+		-DFNA3D_DRIVER_VULKAN
+		-DFNA3D_DRIVER_OPENGL
+	)
+	add_definitions(
+		-DSUPPORT_PROFILE_GLSPIRV=0
+		-DSUPPORT_PROFILE_SPIRV=0
+	)
+endif()
+
 if(EMSCRIPTEN)
 	remove_definitions(
 		-DFNA3D_DRIVER_VULKAN
@@ -170,6 +183,12 @@ set_target_properties(FNA3D PROPERTIES OUTPUT_NAME "FNA3D"
 # Internal Dependencies
 target_link_libraries(FNA3D PRIVATE mojoshader ${LOBJC})
 
+if(WINDOWS_STORE)
+	# the winrt path calls D3D11CreateDevice and CreateDXGIFactory1 directly, the app container
+	# cannot LoadLibrary a system dll
+	target_link_libraries(FNA3D PUBLIC d3d11 dxgi)
+endif()
+
 # SDL2 Dependency
 if (DEFINED SDL2_INCLUDE_DIRS AND DEFINED SDL2_LIBRARIES)
 	message(STATUS "using pre-defined SDL2 variables SDL2_INCLUDE_DIRS and SDL2_LIBRARIES")
diff --git a/src/FNA3D_Driver_D3D11.c b/src/FNA3D_Driver_D3D11.c
index 0988fd0..9da3243 100644
--- a/src/FNA3D_Driver_D3D11.c
+++ b/src/FNA3D_Driver_D3D11.c
@@ -5485,7 +5485,21 @@ static HRESULT D3D11_PLATFORM_ResizeSwapChain(
 	 * -flibit
 	 */
 	int w, h;
+	DXGI_SWAP_CHAIN_DESC liveDesc;
+	HRESULT res;
+
 	SDL_GetWindowSize((SDL_Window*) swapchainData->windowHandle, &w, &h);
+
+	/* a same size resize on a corewindow flip chain returns S_OK and then leaves the device
+	 * DXGI_ERROR_DEVICE_RESET, measured on xbox */
+	res = IDXGISwapChain_GetDesc(swapchainData->swapchain, &liveDesc);
+	if (	SUCCEEDED(res) &&
+		liveDesc.BufferDesc.Width == (UINT) w &&
+		liveDesc.BufferDesc.Height == (UINT) h	)
+	{
+		return S_OK;
+	}
+
 	return IDXGISwapChain_ResizeBuffers(
 		swapchainData->swapchain,
 		0,			/* keep # of buffers the same */


