+						pcm[i * 2] = (byte) value;
+						pcm[(i * 2) + 1] = (byte) (value >> 8);
+					}
+
+					return new SoundEffect(pcm, (int) info.sample_rate, (AudioChannels) info.channels);
+				}
+				finally
