+		public static SoundEffect FromStream(Stream stream, bool vorbis)
+		{
+			if (!vorbis)
+			{
+				return FromStream(stream);
+			}
+
+			byte[] encoded;
+			using (MemoryStream copy = new MemoryStream())
+			{
+				stream.CopyTo(copy);
+				encoded = copy.ToArray();
+			}
+
+			GCHandle pin = GCHandle.Alloc(encoded, GCHandleType.Pinned);
+			try
+			{
+				int error;
+				IntPtr decoder = FAudio.stb_vorbis_open_memory(pin.AddrOfPinnedObject(), encoded.Length, out error, IntPtr.Zero);
+				if (decoder == IntPtr.Zero)
+				{
+					throw new InvalidOperationException("Not a readable Ogg Vorbis stream, stb_vorbis error " + error.ToString());
+				}
+
+				try
+				{
+					FAudio.stb_vorbis_info info = FAudio.stb_vorbis_get_info(decoder);
+					if (info.channels < 1 || info.channels > 2)
+					{
+						throw new NotSupportedException("SoundEffect takes mono or stereo, the stream has " + info.channels.ToString() + " channels");
+					}
+
+					int totalFloats = (int) FAudio.stb_vorbis_stream_length_in_samples(decoder) * info.channels;
+					float[] samples = new float[totalFloats];
+					int framesRead = FAudio.stb_vorbis_get_samples_float_interleaved(decoder, info.channels, samples, totalFloats);
+
+					int sampleCount = framesRead * info.channels;
+					byte[] pcm = new byte[sampleCount * 2];
+					for (int i = 0; i < sampleCount; i += 1)
+					{
+						short value = (short) (MathHelper.Clamp(samples[i], -1.0f, 1.0f) * short.MaxValue);
+						pcm[i * 2] = (byte) value;
+						pcm[(i * 2) + 1] = (byte) (value >> 8);
+					}
+
+					return new SoundEffect(pcm, (int) info.sample_rate, (AudioChannels) info.channels);
+				}
+				finally
+				{
+					FAudio.stb_vorbis_close(decoder);
+				}
+			}
+			finally
+			{
+				pin.Free();
+			}
+		}
