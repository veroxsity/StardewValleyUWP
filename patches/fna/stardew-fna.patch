+			for (int level = 0; level < levels; level += 1)
+			{
+				int levelWidth = Math.Max(1, Width >> level);
+				int levelHeight = Math.Max(1, Height >> level);
+				int size = blocks
+					? ((levelWidth + 3) / 4) * ((levelHeight + 3) / 4) * formatSize
+					: levelWidth * levelHeight * formatSize;
